#!/bin/sh
set -eu

command_name="${1:-}"

case "$command_name" in
    build-base)
        izanagi_source="${IZANAGI_SOURCE:-../izanagi}"
        if [ ! -f "$izanagi_source/Makefile" ]; then
            echo "Izanagi source not found: $izanagi_source" >&2
            exit 1
        fi
        exec make -C "$izanagi_source" image \
            IMAGE_NAME=izanagi-vm-debian:0.2.4 \
            RUNTIME=docker
        ;;
    build)
        docker build --tag temiya-dev --file .izanagi/Dockerfile .
        ;;
    up)
        mkdir -p "${HOME}/.izanagi/tmp"
        chmod 700 "${HOME}/.izanagi/tmp"
        TMPDIR="${HOME}/.izanagi/tmp" exec izanagi up
        ;;
    down)
        exec izanagi down
        ;;
    test)
        exec izanagi exec -- env \
            CARGO_HOME=/tmp/temiya-cargo-home \
            CARGO_TARGET_DIR=/tmp/temiya-target \
            RUSTC=/usr/local/cargo/bin/rustc \
            RUSTDOC=/usr/local/cargo/bin/rustdoc \
            RUSTUP_HOME=/usr/local/rustup \
            /usr/local/cargo/bin/cargo test --locked
        ;;
    build-check)
        exec izanagi exec -- env \
            CARGO_HOME=/tmp/temiya-cargo-home \
            CARGO_TARGET_DIR=/tmp/temiya-target \
            RUSTC=/usr/local/cargo/bin/rustc \
            RUSTDOC=/usr/local/cargo/bin/rustdoc \
            RUSTUP_HOME=/usr/local/rustup \
            /usr/local/cargo/bin/cargo build --locked
        ;;
    shell)
        exec izanagi shell
        ;;
    codex-auth)
        auth_file="${CODEX_HOME:-${HOME}/.codex}/auth.json"
        if [ ! -f "$auth_file" ]; then
            echo "Codex credentials not found: $auth_file" >&2
            exit 1
        fi

        container_ids="$(docker ps --filter 'name=izanagi-' --format '{{.ID}}')"
        set -- $container_ids
        if [ "$#" -ne 1 ]; then
            echo "expected exactly one running Izanagi container; found $#" >&2
            exit 1
        fi
        container_id="$1"

        docker exec --user root "$container_id" \
            install -d -m 700 -o izanagi -g izanagi /home/izanagi/.codex
        docker cp "$auth_file" "$container_id":/home/izanagi/.codex/auth.json
        docker exec --user root "$container_id" \
            chown izanagi:izanagi /home/izanagi/.codex/auth.json
        docker exec --user root "$container_id" \
            chmod 600 /home/izanagi/.codex/auth.json
        echo "Copied Codex credentials into the running sandbox."
        ;;
    logs)
        exec izanagi logs --suspicious
        ;;
    *)
        echo "usage: $0 {build-base|build|up|down|test|build-check|shell|codex-auth|logs}" >&2
        exit 2
        ;;
esac
